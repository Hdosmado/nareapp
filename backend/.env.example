# --- Servidor ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Base de datos (PostgreSQL + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nareapp
DB_PASSWORD=nareapp
DB_NAME=nareapp
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT ---
JWT_ACCESS_SECRET=cambiar-en-produccion-access-secret
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=cambiar-en-produccion-refresh-secret
JWT_REFRESH_TTL=30d

# --- Zona horaria operativa ---
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Firebase Cloud Messaging (push) — opcional en MVP inicial ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Google Maps (geocoding de domicilios) ---
GOOGLE_MAPS_API_KEY=

# --- Activación de dispositivos ---
ACTIVATION_URL_BASE=https://app.empresa.com
ACTIVATION_CODE_TTL_HOURS=24
ACTIVATION_MAX_CLAIM_ATTEMPTS=5
ACTIVATION_CLAIM_RATE_LIMIT=30
APP_DOWNLOAD_URL=https://app.empresa.com/descargar
