# Variables de entorno para los tests automatizados (e2e).
# Usa una base de datos separada que se recrea en cada corrida.
NODE_ENV=test
PORT=3001
API_PREFIX=api

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nareapp
DB_PASSWORD=nareapp
DB_NAME=nareapp_test
DB_SYNCHRONIZE=true
DB_LOGGING=false

JWT_ACCESS_SECRET=nareapp-test-access-secret
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=nareapp-test-refresh-secret
JWT_REFRESH_TTL=30d

APP_TIMEZONE=America/Argentina/Buenos_Aires

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
GOOGLE_MAPS_API_KEY=

# --- Activación de dispositivos ---
ACTIVATION_URL_BASE=https://app.empresa.com
ACTIVATION_CODE_TTL_HOURS=24
ACTIVATION_MAX_CLAIM_ATTEMPTS=5
ACTIVATION_CLAIM_RATE_LIMIT=30
APP_DOWNLOAD_URL=https://app.empresa.com/descargar
